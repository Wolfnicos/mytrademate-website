# MyTradeMate Environment Variables
# Copy this file to .env and fill in your actual keys
# IMPORTANT: Never commit .env to git!

# ====================
# SYNCFUSION LICENSE
# ====================
# Get your free community license at: https://www.syncfusion.com/sales/communitylicense
# Valid for 1 year for individual developers
SYNCFUSION_LICENSE=your_syncfusion_license_key_here

# ====================
# REVENUECAT API KEYS
# ====================
# Get these from RevenueCat dashboard: https://app.revenuecat.com/
# Apple App Store API Key
REVENUECAT_APPLE_KEY=appl_your_apple_key_here

# Google Play Store API Key
REVENUECAT_GOOGLE_KEY=goog_your_google_key_here

# ====================
# HOW TO USE
# ====================
# Development:
#   flutter run --dart-define=SYNCFUSION_LICENSE=key --dart-define=REVENUECAT_APPLE_KEY=key
#
# Production build:
#   flutter build ios --dart-define=SYNCFUSION_LICENSE=key --dart-define=REVENUECAT_APPLE_KEY=key
#
# Or create a build script that reads from .env file
